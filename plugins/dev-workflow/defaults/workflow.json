{
  "language": "ja",
  "base_branch": "main",
  "require_status_checks": true,
  "allow_ai_merge": false,
  "project": {
    "owner": null,
    "number": null
  },
  "status": {
    "todo": "Todo",
    "hold": null,
    "start": "In Progress",
    "pr_opened": null,
    "done": "Done"
  },
  "story_point": {
    "field": "Story Point"
  },
  "review": {
    "max_rounds": 3,
    "model": null,
    "code_review_effort": null
  },
  "checks": {
    "commands": null
  },
  "sub_issues": {
    "max_depth": 3
  },
  "labels": {
    "types": ["feat", "fix", "refactor", "perf", "test", "docs", "build", "ci", "chore"]
  },
  "branch": {
    "pattern": "{type}/{issue_number}-{slug}",
    "worktree_dir": ".claude/worktrees"
  },
  "commit": {
    "types": ["feat", "fix", "refactor", "perf", "test", "docs", "build", "ci", "chore", "style", "revert"],
    "pattern": "^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\\([a-z0-9-]+\\))?!?: .+",
    "scope_required": false
  },
  "adr": {
    "dir": "docs/adr",
    "suggest": true
  },
  "pr": {
    "title_pattern": "^(feat|fix|refactor|perf|test|docs|build|ci|chore|style|revert)(\\([a-z0-9-]+\\))?!?: .+",
    "draft": false,
    "close_keyword": "Closes",
    "template": null
  },
  "pr_check": {
    "handlers": {}
  },
  "auto": {
    "enabled": false,
    "max_fix_attempts": 3,
    "max_new_issues": 3,
    "merge": {
      "enabled": false,
      "require_human_approval": false
    },
    "chain": {
      "enabled": false,
      "max": 3,
      "wait_minutes": 120
    }
  },
  "repair": {
    "enabled": false,
    "allowed_authors": [],
    "wait_for_reviewers": [],
    "review_wait_minutes": 60,
    "max_fix_attempts": 3,
    "max_pushes_per_pr": 5,
    "bot_logins": [],
    "reply_logins": []
  }
}
